<Window x:Class="PR30_3_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR30_3_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="table1Grid" Grid.Row="0" ItemsSource="{Binding Table1}" />
        <DataGrid x:Name="table2Grid" Grid.Row="0" ItemsSource="{Binding Table2}" />
        <DataGrid x:Name="table3Grid" Grid.Row="0" ItemsSource="{Binding Table3}" />

        <Button Grid.Row="1" Content="Refresh" Click="Refresh_Click" />
    </Grid>
</Window>
