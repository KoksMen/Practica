        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR26_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="164" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBox Margin="20 20 20 0" x:Name="tb1"/>
            <TextBox Margin="20 20" x:Name="tb2" IsEnabled="False"/>
            <Button Content="Make action" Margin="20 0" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
