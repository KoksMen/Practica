<Window x:Class="PR26_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR26_2"
        mc:Ignorable="d"
        Title="Магический шар предсказаний" Height="450" Width="400" Background="White">
    <Grid>
        <Ellipse Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Height="374"/>
        <Ellipse Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top" Width="100" Height="100" Margin="0,65,0,0"/>
        <TextBlock x:Name="numberTextBlock" Height="NaN" Margin="168,82,168,286" Width="NaN" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/> 
        <TextBox x:Name="questionTextBox" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="30" FontSize="20"/>
        <TextBox x:Name="resultTextBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,257,0,0" Width="200" Height="30" IsReadOnly="True" FontSize="20"/>
        <Button Content="Предсказать" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,310,0,0" Width="200" Click="PredictButton_Click" Height="40"/>
    </Grid>
</Window>
