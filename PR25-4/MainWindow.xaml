<Window x:Class="PR25_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR25_4"
        mc:Ignorable="d"
        Title="Приложение млекопитающих" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Наименование:"/>
        <TextBox x:Name="nameTextBox" Grid.Row="0" Margin="5"/>

        <Label Content="Подвид:" Grid.Row="1"/>
        <TextBox x:Name="subspeciesTextBox" Grid.Row="1" Margin="5"/>

        <Label Content="Продолжительность жизни:" Grid.Row="2"/>
        <TextBox x:Name="lifespanTextBox" Grid.Row="2" Margin="5"/>

        <Button Content="Очистить" Click="ClearButton_Click" Grid.Row="3" HorizontalAlignment="Left" Margin="5"/>
        <Button Content="Сохранить" Click="SaveButton_Click" Grid.Row="3" HorizontalAlignment="Right" Margin="5"/>
    </Grid>
</Window>
