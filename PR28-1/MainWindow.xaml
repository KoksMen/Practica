<Window x:Class="PR28_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR28_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,-39,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="417*"/>
            <ColumnDefinition Width="383*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Ellipse Height="70" Fill="Red" Stroke="Black" StrokeThickness="2" Width="150" Grid.Row="0" Grid.Column="0"/>
        <Ellipse Width="80" Height="80" Fill="Blue" Stroke="Red" StrokeThickness="5" Grid.Row="0" Grid.Column="1"/>

        <Border BorderBrush="GreenYellow" BorderThickness="2" CornerRadius="10" Grid.Row="1" Grid.Column="0" Width="150" Height="90">
            <Border.Background>
                <ImageBrush Stretch="Fill" ImageSource="image.png"/>
            </Border.Background>
        </Border>
        
        <Border BorderBrush="Black" BorderThickness="10" CornerRadius="20" Background="GreenYellow" Height="90" Width="150" Grid.Row="1" Grid.Column="1"/>

        <TextBlock Text="Click on rectangle1" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
