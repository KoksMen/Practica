<Window x:Class="PR26_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR26_3"
        mc:Ignorable="d"
        Title="Mammals App - Main Window" Height="250" Width="400">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Выберите млекопитающее:" FontWeight="Bold" />
            <ComboBox x:Name="mammalsComboBox" SelectionChanged="MammalsComboBox_SelectionChanged">
                <ComboBoxItem Content="Лев" />
                <ComboBoxItem Content="Слон" />
                <ComboBoxItem Content="Тигр" />
                <ComboBoxItem Content="Обезьяна" />
                <ComboBoxItem Content="Кит" />
            </ComboBox>
        </StackPanel>
    </Grid>
</Window>
