<Window x:Class="PR29_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR29_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Button.Click">
            <EventTrigger.Actions>
                <BeginStoryboard>
                    <Storyboard Timeline.DesiredFrameRate="60">
                        <DoubleAnimation Storyboard.TargetName="ball" Storyboard.TargetProperty="(Canvas.Bottom)"
From="0" To="300" AutoReverse="True" Duration="0:0:2.5" RepeatBehavior="Forever"
DecelerationRatio="1"/>


                        <DoubleAnimation Storyboard.TargetName="rectangle" 
                                         Storyboard.TargetProperty="Width"
                                         From="0" To="300" 
                                         AutoReverse="True" 
                                         Duration="0:0:2.5" 
                                         RepeatBehavior="Forever"
                                         DecelerationRatio="1"

                                         />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger.Actions>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Canvas Background="Blue" Margin="0,0,368,0">
            <Ellipse Name="ball" Fill="Green" Stroke="Black" Width="50" Height="50"
Canvas.Left="125" Canvas.Bottom="0" />
        </Canvas>

        <Canvas Background="Blue" Margin="400,0,10,0">
            <Rectangle Name="rectangle" Fill="Red" Stroke="Black" Width="50" Height="50"
Canvas.Left="125" Canvas.Bottom="0" />
        </Canvas>


        <Button Width="700" Height="25" Content="Кнопка" Grid.Row="1" Margin="10" />

    </Grid>
</Window>
