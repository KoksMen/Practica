<Window x:Class="PR27_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR27_3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <Label Content="Последние документы"/>
            <Button Content="Открыть" Height="20" Margin="10 0 10 0"/>
            <Button Content="Сохранить" Height="20" Margin="10 0 10 0"/>
            <Button Content="Закрыть" Height="20" Margin="10 0 10 0"/>
            <Button Content="Обработать" Height="20" Margin="10 0 10 0"/>
            <Button Content="О Программе" Height="20" Margin="10 0 10 0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0 30 0 0">
            <ListView>
                <ListViewItem Content="1.txt."/>
                <ListViewItem Content="2.txt."/>
                <ListViewItem Content="3.txt."/>
                <ListViewItem Content="4.txt."/>
                <ListViewItem Content="5.txt."/>
                <ListViewItem Content="6.txt."/>
            </ListView>

            <StackPanel Orientation="Vertical" Width="754">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="1.txt" Margin="50 0 5 0" FontWeight="Bold"/>
                    <TextBlock Text="2.txt" Margin="10 0 5 0"/>
                    <TextBlock Text="3.txt" Margin="10 0 5 0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <WrapPanel Orientation="Horizontal" Height="387" Margin="42,47,10,0" >
            <Grid>
                <Rectangle Fill="Red" Width="120" Height="120" />
                <TextBlock Text="A" Margin="50"/>
            </Grid>
            <Grid>
                <Rectangle Fill="Blue" Width="120" Height="120" />
                <TextBlock Text="B" Margin="50"/>

            </Grid>
            <Grid>
                <Rectangle Fill="Green" Width="120" Height="120" />
                <TextBlock Text="C" Margin="50"/>

            </Grid>
            <Grid>
                <Rectangle Fill="Yellow" Width="120" Height="120" />
                <TextBlock Text="D" Margin="50"/>
            </Grid>
            <Grid>
                <Rectangle Fill="Purple" Width="120" Height="120" />
                <TextBlock Text="E" Margin="50"/>
            </Grid>
            <Grid>
                <Rectangle Fill="Orange" Width="120" Height="120" />
                <TextBlock Text="F" Margin="50"/>
            </Grid>

        </WrapPanel>

    </Grid>
    
</Window>
