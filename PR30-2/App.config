<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="PR30_2.Properties.Settings.CookingBookConnectionString"
            connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\CookingBook.mdf;Integrated Security=True;User Instance=True;Connect Timeout=30"
            providerName="System.Data.SqlClient" />
