<Window x:Class="PR31_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR31_2"
        mc:Ignorable="d"
        Title="Dish Management" Height="720" Width="629">
        <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>    
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
            <Label Content="Тип блюда:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtDishType" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Label Content="Вес блюда:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtDishWeight" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Label Content="Порядок приготовления:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtPreparationOrder" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Label Content="Количество калорий:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtCaloryCount" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Label Content="Количество углеводов:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtCarbCount" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Button Content="Добавить" Click="AddButton_Click" Margin="5" Width="139" HorizontalAlignment="Left"/>
    </StackPanel>
    <DataGrid x:Name="dgvDishes" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" AutoGenerateColumns="False" Height="NaN">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Код" Binding="{Binding Code}"/>
            <DataGridTextColumn Header="Тип блюда" Binding="{Binding DishType}"/>
            <DataGridTextColumn Header="Вес блюда" Binding="{Binding DishWeight}"/>
            <DataGridTextColumn Header="Порядок приготовления" Binding="{Binding PreparationOrder}"/>
            <DataGridTextColumn Header="Количество калорий" Binding="{Binding CaloryCount}"/>
            <DataGridTextColumn Header="Количество углеводов" Binding="{Binding CarbCount}"/>
        </DataGrid.Columns>
    </DataGrid>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
            <Label Content="Новый тип блюда:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtNewDishType" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Label Content="Новый вес блюда:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtNewDishWeight" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Label Content="Порядок приготовления:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtNewPreparationOrder" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Label Content="Количество калорий:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtNewCaloryCount" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Label Content="Количество углеводов:" Margin="5" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtNewCarbCount" Margin="5" Width="100" HorizontalAlignment="Left"/>
            <Button Content="Изменить" Click="UpdateButton_Click" Margin="5" HorizontalAlignment="Left"/>
        </StackPanel>

        <Button Content="Удалить" Click="DeleteButton_Click" Grid.Row="0" Grid.Column="2" Width="150" Height="30"/>
    </Grid>
</Window>
